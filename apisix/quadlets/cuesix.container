[Unit]
Description=Podman - Cuesix
Requires=apisix-network.service
Wants=apisix.service
After=apisix.service

[Container]
Image=cuesix:latest
ReadOnly=true
#AutoUpdate=registry
ContainerName=cuesix
Environment=APISIX_STAND_ALONE=true
Environment=CUESIX_CERTMAGIC=true
Environment=CUESIX_CERTMAGIC_CHALLENGE_PORT=8882
Environment=CUESIX_CERTMAGIC_DATA_DIR=/acme
Environment=CUESIX_CERTMAGIC_DEFAULT_PROVIDER=staging
Environment=CUESIX_CERTMAGIC_PROVIDERS="staging|soporte@fivecorporation.com|https://acme-staging-v02.api.letsencrypt.org/directory,prod|soporte@fivecorporation.com|https://acme-v02.api.letsencrypt.org/directory"
Environment=CUESIX_COOLDOWN=30s
Environment=CUESIX_INPUT_DIRS=/input
Environment=CUESIX_PLUGIN_JQ=true
Environment=CUESIX_PLUGIN_SSL=true
Environment=CUESIX_PLUGIN_SSL_FALLBACK_CERT=/usr/local/apisix/conf/cert/ssl_PLACE_HOLDER.crt
Environment=CUESIX_PLUGIN_SSL_FALLBACK_KEY=/usr/local/apisix/conf/cert/ssl_PLACE_HOLDER.key
Environment=CUESIX_PLUGIN_SSL_PATHS=/usr/local/apisix/conf/cert
Environment=CUESIX_PLUGIN_YAML=true
#Environment=CUESIX_APISIX_API_KEY=
#Environment=CUESIX_APISIX_URL=http://apisix-gw:9090
Environment=CUESIX_LISTEN=:8880
Environment=CUESIX_METRICS_LISTEN=:8881
Environment=CUESIX_SERVER_AUTO_TRIGGER=true
Volume=/opt/apisix/conf:/usr/local/apisix/conf
Volume=/opt/apisix/conf/config.yaml:/usr/local/apisix/conf/config.yaml:ro
Volume=/opt/apisix/acme:/acme
Volume=/opt/apisix/input:/input:ro
Volume=/opt/apisix/tmp:/tmp
Volume=/opt/apisix/certs:/usr/local/apisix/certs:ro
Volume=/opt/apisix/conf:/usr/local/apisix/conf
Volume=/opt/apisix/conf/config.yaml:/usr/local/apisix/conf/config.yaml:ro
# These are required to validate configs
Volume=/opt/apisix/logs:/usr/local/apisix/logs
Volume=/opt/apisix/tmp:/var/lib/nginx/tmp
Exec=serve
# compiler
PublishPort=8880:8880
# metrics
PublishPort=8881:8881
# acme
PublishPort=8882:8882
# USER_ID value is obtained with `id -u` while logged into {USER}
User=1000
# GROUP_ID value is obtained with `id -g` while logged into {USER}
Group=1000
Network=apisix.network

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

