[Unit]
Description=Podman - APISix
Requires=apisix-network.service
Wants=apisix-network.service
After=apisix-network.service

[Container]
Image=docker.io/apache/apisix:3.14.1-debian
ReadOnly=true
AutoUpdate=registry
ContainerName=apisix-gw
Environment=APISIX_STAND_ALONE=true
# Apisix needs to write things here.
# The main files needed in this volume are:
# - config.yaml: Static, from configmap.
# - apisix.[yaml|json]: Generated by sixpack
# - mime.types: Must be copied with initcontainer
# - cert/ssl_PLACE_HOLDER.crt: Must be copied with initcontainer
# - cert/ssl_PLACE_HOLDER.key: Must be copied with initcontainer
Volume=/opt/apisix/conf:/usr/local/apisix/conf
Volume=/opt/apisix/conf/config.yaml:/usr/local/apisix/conf/config.yaml:ro
# Move temp folders to a mount point
# Requires config.yaml:
# nginx_config:
#   http_configuration_snippet: |
#     client_body_temp_path /var/lib/nginx/tmp/client_body;
#     proxy_temp_path       /var/lib/nginx/tmp/proxy;
#     fastcgi_temp_path     /var/lib/nginx/tmp/fastcgi;
#     uwsgi_temp_path       /var/lib/nginx/tmp/uwsgi;
#     scgi_temp_path        /var/lib/nginx/tmp/scgi;
Volume=/opt/apisix/logs:/usr/local/apisix/logs
Volume=/opt/apisix/certs:/usr/local/apisix/certs:ro
Volume=/opt/apisix/tmp:/var/lib/nginx/tmp
PublishPort=9180:9180
PublishPort=80:9080
PublishPort=9090:9090
PublishPort=9091:9091
PublishPort=443:9443
PublishPort=9092:9092
# sixpack port
PublishPort=8080:8080
# USER_ID value is obtained with `id -u` while logged into {USER}
User=1000
# GROUP_ID value is obtained with `id -g` while logged into {USER}
Group=1000
Network=apisix.network

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

